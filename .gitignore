# Only the handbook and the files needed to publish it are tracked.
# Everything else in this folder is ignored by default.
/*
!/.gitignore
!/LICENSE
!/README.md
!/mkdocs.yml
!/requirements.txt
!/site_hooks.py
!/site_toolkit.py
!/site_sheets.py
!/site_theme/
!/.github/
!/Handbook/
/Handbook/**/*.pdf
# Game art stays out of the public repo until the developer gives permission.
/Handbook/**/*.png
